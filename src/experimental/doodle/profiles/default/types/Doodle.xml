<?xml version="1.0" encoding="utf-8"?>
<object meta_type="Dexterity FTI"
        name="Doodle"
        i18n:domain="plone"
        xmlns:i18n="http://xml.zope.org/i18n"
        >
  <property name="title"
            i18n:translate=""
            >Doodle</property>
  <property name="description"
            i18n:translate=""
            >Poll participants on meeting dates.</property>
  <property name="factory">doodle</property>
  <property name="schema">experimental.doodle.content.interfaces.IDoodle</property>
  <property name="klass">experimental.doodle.content.doodle.Doodle</property>
  <property name="add_view_expr">string:${folder_url}/++add++Doodle</property>
  <property name="icon_expr">string:contenttype/event</property>
  <property name="filter_content_types">True</property>
  <property name="allowed_content_types" />
  <property name="global_allow">True</property>
  <property name="allow_discussion">False</property>
  <property name="default_view">view</property>
  <property name="default_view_fallback">True</property>
  <property name="view_methods">
    <element value="view" />
    <element value="results" />
  </property>
  <property name="behaviors">
    <element value="plone.dublincore" />
    <element value="plone.namefromtitle" />
  </property>
</object>
