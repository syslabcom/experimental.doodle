<?xml version="1.0" encoding="utf-8"?>
<object xmlns:i18n="http://xml.zope.org/namespaces/i18n"
        meta_type="Dexterity FTI"
        name="experimental.doodle.folder"
        i18n:domain="experimental.doodle"
>
  <property name="title"
            i18n:translate=""
  >Doodle Folder</property>
  <property name="description"
            i18n:translate=""
  >Folderish container for doodle dates.</property>
  <property name="icon_expr">string:${portal_url}/++theme++plonetheme.barceloneta/images/contenttypes/folder.svg</property>
  <property name="factory">experimental.doodle.folder</property>
  <property name="add_view_expr">string:${folder_url}/++add++experimental.doodle.folder</property>
  <property name="link_target" />
  <property name="immediate_view">doodle</property>
  <property name="global_allow">True</property>
  <property name="filter_content_types">True</property>
  <property name="allowed_content_types">
    <element value="experimental.doodle.date" />
  </property>
  <property name="allow_discussion">False</property>
  <property name="default_view">doodle</property>
  <property name="view_methods">
    <element value="view" />
    <element value="doodle" />
  </property>
  <property name="default_view_fallback">False</property>
  <property name="add_permission">experimental.doodle.AddDoodleFolder</property>
  <property name="klass">experimental.doodle.content.folder.ExperimentalDoodleFolder</property>
  <property name="schema">experimental.doodle.interfaces.IExperimentalDoodleFolder</property>
  <property name="model_source" />
  <property name="model_file" />
  <property name="behaviors">
    <element value="plone.namefromtitle" />
    <element value="plone.dublincore" />
    <element value="plone.basic" />
    <element value="plone.excludefromnavigation" />
    <element value="plone.shortname" />
    <element value="plone.leadimage" />
    <element value="plone.ownership" />
    <element value="plone.publication" />
    <element value="plone.categorization" />
    <element value="plone.locking" />
    <element value="plone.versioning" />
  </property>
  <alias from="(Default)"
         to="(dynamic view)"
  />
  <alias from="edit"
         to="@@edit"
  />
  <alias from="sharing"
         to="@@sharing"
  />
  <alias from="view"
         to="(selected layout)"
  />
  <action action_id="view"
          category="object"
          condition_expr=""
          title="View"
          url_expr="string:${object_url}"
          visible="True"
  >
    <permission value="View" />
  </action>
  <action action_id="edit"
          category="object"
          condition_expr=""
          title="Edit"
          url_expr="string:${object_url}/edit"
          visible="True"
  >
    <permission value="Modify portal content" />
  </action>
</object>
