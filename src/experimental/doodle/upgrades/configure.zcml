<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="experimental.doodle"
    >

  <genericsetup:upgradeStep
      title="Install Poll content type"
      description="Register the Poll Dexterity FTI on existing sites."
      profile="experimental.doodle:default"
      source="1000"
      destination="1001"
      handler="experimental.doodle.upgrades.v1001.install_poll_type"
      />

  <genericsetup:upgradeStep
      title="Register Poll browser views"
      description="Update the Poll FTI default view on existing sites."
      profile="experimental.doodle:default"
      source="1001"
      destination="1002"
      handler="experimental.doodle.upgrades.v1002.install_poll_views"
      />

  <!-- -*- extra stuff goes here -*- -->

</configure>
